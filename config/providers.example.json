{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "genai-mil": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GenAI.mil",
      "options": {
        "baseURL": "https://api.genai.mil/v1",
        "apiKey": "{env:GENAI_MIL_API_KEY}"
      },
      "models": {
        "gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro Preview" },
        "gemini-3-flash-preview": { "name": "Gemini 3 Flash Preview" },
        "gemini-2.5-pro":         { "name": "Gemini 2.5 Pro" },
        "gemini-2.5-flash":       { "name": "Gemini 2.5 Flash" }
      }
    },
    "org-gptoss": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Org GPT-OSS 120B",
      "options": {
        "baseURL": "https://your-internal-llm-endpoint/v1"
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    },
    "org-gemma": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Org Gemma 4",
      "options": {
        "baseURL": "https://your-internal-llm-endpoint-2/v1"
      },
      "models": {
        "google/gemma-4-31B-it": {
          "name": "Gemma 4 31B IT",
          "limit": { "context": 256000, "output": 8192 }
        }
      }
    }
  }
}
